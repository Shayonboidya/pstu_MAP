# PSTU Campus Map - Environment Variables

# ==========================================
# SUPABASE CONFIGURATION (REQUIRED)
# ==========================================
# Get these from your Supabase Project Settings > API
# https://supabase.com/dashboard/_/settings/api
#
# WARNING: Never commit your real credentials to version control.
# Copy this file to .env and fill in your actual values.

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anonymous/public key (safe for client-side)
# This key allows limited operations based on RLS policies
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ==========================================
# APPLICATION CONFIGURATION (OPTIONAL)
# ==========================================
VITE_APP_NAME="PSTU Campus Map"
VITE_APP_URL=http://localhost:5173
